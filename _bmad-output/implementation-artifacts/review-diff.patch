+.compact { padding: .18rem 0; }
+.compact .row { align-items: center; }
+.compact .node { height: 26px; border: 0; }
+.compact .card { gap: 0; }
+.compact .name { font-size: 15px; line-height: 1.25; }
+.compact .when { font-size: 10px; letter-spacing: .1em; }
+.compact .meta { font-size: 10.5px; }
+
+/* La colonne se resserre : les cartes compactes se rapprochent de la ligne. */
+.compact.left  .card { padding-right: .5rem; }
+.compact.right .card { padding-left: .5rem; }
+
+@media (max-width: 800px) {
+  .compact .logo, .compact .logoFallback { max-height: 22px; }
+  .compact.left .card, .compact.right .card { padding: 0; }
+}
+
+
+/* Variante du repère quand rien n'est encore passé : il ferme le fil au lieu de
+   le couper en deux. */
+.todayMarkTail { margin: 1rem 0 0; }
+
+/* En forme compacte, `--node` est redéfini sur le rang alors que la ligne est
+   tracée d'après la valeur portée par le ruban : sur mobile, où la ligne est
+   calée à gauche, les pastilles compactes se retrouvaient à 13px du filet.
+   On garde donc la même gouttière et on ne réduit que l'image. */
+.compact .node { width: var(--node); }
+.compact .logo, .compact .logoFallback { max-height: 26px; }
+.compact .logoFallback { font-size: 13px; }
+

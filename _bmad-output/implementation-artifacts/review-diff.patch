+.todayMark { margin: 0 0 1rem; text-align: center; }
+.item:first-child .year { margin-top: .25rem; }
+.year span {
+  display: inline-block;
+  background-color: var(--c-bg);
+  padding: 0 14px;
+  font-family: var(--font-title);
+  font-size: 15px;
+  letter-spacing: .2em;
+  color: var(--c-faint);
+}
+.todayMark span {
+  display: inline-block;
+  /* Encre et non l'accent : blanc sur #c43d8c tombe à ~3,9:1, sous le seuil
+     AA pour du 10px gras. Le repère reste le seul élément plein du fil. */
+  background-color: var(--c-text);
+  color: var(--c-bg);
+  padding: 3px 12px 2px;
+  font-size: 10px;
+  font-weight: 700;
+  letter-spacing: .18em;
+  text-transform: uppercase;
+}
+
+/* ══════════════ En live ══════════════
+   Étiquette collée, reprise du vocabulaire de la couverture. Encre et blanc en
+   dur : ces valeurs ne suivent pas le thème, comme sur la home. */
+.liveTape {
+  align-self: flex-start;
+  margin-top: 6px;
+  display: inline-flex;
+  align-items: center;
+  gap: 7px;
+  background: #fff;
+  color: #2a1e30;
+  padding: 4px 10px 3px;
+  font-size: 10.5px;
+  font-weight: 700;
+  letter-spacing: .12em;
+  text-transform: uppercase;
+  transform: rotate(-1.8deg);
+  clip-path: var(--tape-clip-alt);
+  filter: var(--tape-shadow);
+}
+.left .liveTape { align-self: flex-end; }
+.liveDot {
+  width: 7px;
+  height: 7px;
+  border-radius: 50%;
+  background: #d32f4f;
+  flex-shrink: 0;
+  animation: livePulse 1.8s ease-in-out infinite;
+}
+@keyframes livePulse { 0%, 100% { opacity: 1 } 50% { opacity: .35 } }
+@media (prefers-reduced-motion: reduce) { .liveDot { animation: none } }
+
+.live .node { box-shadow: 0 0 0 2px var(--c-accent); }
+
+/* Annulée : barrée, jamais masquée — l'information vaut mieux que le silence. */
+.cancelled .name { text-decoration: line-through; }
+.cancelledTag {
+  color: var(--c-danger);
+  font-weight: 700;
+  letter-spacing: .1em;
+  text-transform: uppercase;
+  font-size: 11px;
+}
+
+/* ══════════════ Mobile ══════════════
+   L'alternance ne tient pas sous ~800px : deux colonnes laisseraient ~150px par
+   carte, où un nom de compétition descend sur huit lignes. La ligne passe donc à
+   gauche et toutes les cartes se rangent à droite — le zigzag est une mise en
+   forme desktop, pas la structure. */
+@media (max-width: 800px) {
+  .ribbon { --node: 48px; --gap: 1rem; padding-left: 1rem; }
+  .ribbon::before { left: calc(1rem + var(--node) / 2); }
+  .row { grid-template-columns: var(--node) 1fr; column-gap: var(--gap); }
+  .node { grid-column: 1; }
+  .left .card, .right .card { grid-column: 2; grid-row: 1; text-align: left; align-items: flex-start; }
+  .left .when, .left .meta { justify-content: flex-start; }
+  .left .liveTape { align-self: flex-start; }
+  .card::after { display: none; }
+  /* Alignés à gauche, sans décalage : `translateX(-50%)` s'appliquait au bloc
+     pleine largeur et non à l'étiquette, ce qui projetait le repère à 220px
+     hors de l'écran. */
+  .year, .todayMark { text-align: left; margin-left: 0; }
+  .name { font-size: clamp(18px, 5vw, 22px); }
+}
+
+
+/* ══════════════ Forme compacte ══════════════
+   Le passé et les autres années passent en ligne dense : le logo descend à la
+   hauteur du texte et la pastille cesse de creuser la colonne. Ce qui reste en
+   pleine forme, ce sont les compétitions à venir de la saison en cours — celles

+++ b/src/components/CompetitionRibbon.module.css
+/* Le fil des compétitions — voir `CompetitionRibbon.jsx`.
+   Déplacé depuis `Competitions.module.css` sans modification : l'apparence
+   appartient au composant, qui sert désormais l'agenda complet ET les pages de
+   circuit. Les règles ci-dessous sont celles du commit 63898a4, à l'octet près. */
+
+/* ══════════════ La ligne de temps ══════════════
+   Le futur est en haut : on lit d'abord ce qui arrive, et on descend vers ce qui
+   a eu lieu. Une ligne court sur toute la hauteur, chaque compétition y pose sa
+   pastille, et la carte part alternativement à gauche puis à droite.
+
+   Les tailles sont IDENTIQUES pour le passé et le futur : une différence
+   d'échelle se lisait comme un défaut de rendu, pas comme une intention. Ce qui
+   distingue les deux, c'est la position par rapport au repère du jour et le
+   retrait de l'encre. */
+.ribbon {
+  --node: 64px;          /* diamètre de la pastille */
+  --gap: 2.25rem;        /* respiration entre la ligne et les cartes */
+  position: relative;
+  max-width: var(--page-max);
+  width: 100%;
+  margin: .5rem auto 5rem;
+  padding: 0 1.25rem;
+  list-style: none;
+}
+/* La ligne elle-même. */
+.ribbon::before {
+  content: "";
+  position: absolute;
+  top: 0;
+  bottom: 0;
+  left: 50%;
+  width: 1px;
+  background: repeating-linear-gradient(
+    to bottom, var(--c-rule) 0 4px, transparent 4px 8px
+  );
+  transform: translateX(-.5px);
+}
+
+.item { position: relative; padding: .9rem 0; }
+
+/* Le rang : pastille au centre, carte d'un côté. Les repères (millésime,
+   marqueur du jour) vivent HORS de cette grille — dans la même, l'auto-placement
+   renvoyait la carte de gauche à la ligne suivante, puisqu'une grille n'écrit
+   jamais en arrière : la carte réclamait la colonne 1 après une pastille déjà
+   posée en colonne 2. */
+.row {
+  display: grid;
+  grid-template-columns: 1fr var(--node) 1fr;
+  align-items: center;
+  column-gap: var(--gap);
+  position: relative;
+}
+
+/* Alternance : la carte occupe la colonne 1 ou la colonne 3. `grid-row: 1` est
+   indispensable des DEUX côtés — sans lui, une carte réclamant la colonne 1
+   après une pastille déjà posée en colonne 2 tombe à la ligne suivante, et se
+   retrouve décalée d'une hauteur de pastille sous son propre repère. */
+.left  .card { grid-column: 1; grid-row: 1; text-align: right; align-items: flex-end; }
+.right .card { grid-column: 3; grid-row: 1; }
+
+/* Le trait qui relie la carte à sa pastille. */
+.card::after {
+  content: "";
+  position: absolute;
+  top: 50%;
+  width: var(--gap);
+  height: 1px;
+  background: var(--c-rule);
+}
+/* Le trait relie le bord de la carte au bord de la pastille : mesuré depuis le
+   milieu du gap, il finissait 18px trop court d'un côté et passait sous la
+   pastille opaque de l'autre. */
+.left  .card::after { left: calc(50% - var(--node) / 2 - var(--gap)); }
+.right .card::after { right: calc(50% - var(--node) / 2 - var(--gap)); }
+
+/* ══════════════ La pastille ══════════════
+   Le repère visuel : c'est lui qui permet de retrouver une compétition sans
+   lire. Le logo est CONTENU, jamais recadré ni étiré — on ne connaît ni son
+   ratio ni son fond. Le cadre pointillé n'apparaît que sur le repli textuel,
+   pour ne pas ajouter de bruit autour d'un logo qui a déjà son propre fond. */
+.node {
+  grid-column: 2;
+  grid-row: 1;
+  width: var(--node);
+  height: var(--node);
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  overflow: hidden;
+  background-color: var(--c-bg);
+  z-index: 1;
+}
+.nodeEmpty { border: 1px dotted var(--c-rule); }
+.logo { max-width: 100%; max-height: 100%; width: auto; height: auto; object-fit: contain; }
+.logoFallback {
+  font-family: var(--font-title);
+  font-size: 20px;
+  letter-spacing: .02em;
+  text-transform: uppercase;
+  color: var(--c-faint);
+}
+
+/* ══════════════ La carte ══════════════ */
+.card { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
+.when {
+  font-family: var(--font-body);
+  font-size: 11px;
+  font-weight: 700;
+  letter-spacing: .12em;
+  text-transform: uppercase;
+  color: var(--c-muted);
+  display: flex;
+  align-items: baseline;
+  flex-wrap: wrap;
+}
+.when > span { white-space: pre; }
+/* Seul le mois prend l'accent : c'est le point d'appui du regard quand on
+   parcourt le fil. Le quantième et l'année restent en gris — les colorer aussi
+   ferait de la date entière un bloc de couleur, et on reperdrait le repère. */
+.month { color: var(--c-accent); }
+.past .month { color: var(--c-accent); opacity: .55; }
+.left .when, .left .meta { justify-content: flex-end; }
+.name {
+  font-family: var(--font-title);
+  font-weight: 400;
+  font-size: clamp(20px, 2.6vw, 26px);
+  line-height: 1.05;
+  letter-spacing: .01em;
+  text-transform: uppercase;
+  color: var(--c-text);
+}
+.meta {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 0 7px;
+  font-size: 12.5px;
+  color: var(--c-muted);
+}
+.meta > span + span::before { content: "\00b7"; margin-right: 7px; color: var(--c-faint); }
+.fuzzy {
+  font-weight: 400;
+  letter-spacing: .04em;
+  text-transform: none;
+  color: var(--c-faint);
+  font-size: 11.5px;
+}
+.card:hover .name { color: var(--c-accent); }
+
+/* ══════════════ L'appel à contribution ══════════════
+   Une entrée du fil comme les autres, à ceci près qu'elle n'a pas de date : le
+   carré pointillé est celui d'une compétition sans logo, et le point
+   d'interrogation y remplace les initiales. Le libellé garde EXACTEMENT
+   l'échelle des autres entrées : une taille à part se lit comme un défaut de
+   rendu, pas comme une intention. Ce qui distingue la ligne, c'est la pastille
+   — accentuée — et l'absence de date. */
+.suggestMark {
+  font-family: var(--font-title);
+  font-size: 30px;
+  line-height: 1;
+  color: var(--c-accent);
+}
+/* Le cadre reprend l'encre du point d'interrogation : les deux forment un seul
+   objet, là où le pointillé gris du repli textuel n'est qu'un contenant. */
+.suggestNode { border-color: var(--c-accent); }
+
+/* Le lien couvre la grille, mais seules la pastille et la carte le reçoivent —
+   sans quoi la colonne vide en ferait une bande cliquable d'un bord à l'autre. */
+.suggestRow { pointer-events: none; }

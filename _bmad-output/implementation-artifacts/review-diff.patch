+.suggestRow:hover .name { color: var(--c-accent); }
+
+/* Le passé (et l'annulé, qui n'aura pas lieu) : même échelle, encre retirée. */
+.past .name { color: var(--c-muted); }
+.past .node { opacity: .62; }
+.past .when, .past .meta { color: var(--c-faint); }
+
+/* ══════════════ Repères sur la ligne ══════════════

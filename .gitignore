.env
.env.local
.env.*.local

# ── Logs & caches d'outils ──────────────────────────────────────────────────
*.log
logs/
.eslintcache
coverage/

# ── Éditeurs & OS ───────────────────────────────────────────────────────────
.idea/
.vscode/
*.sublime*
.DS_*

# ── Outillage BMAD (skills installés, non versionnés) ───────────────────────
_bmad/
.claude/skills/bmad-*
